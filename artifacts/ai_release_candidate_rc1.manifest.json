  "known_limitations_and_unresolved_challenges": [
    {
      "id": "LIM-01",
      "area": "cross_lingual_surface_alignment",
      "description": "While cross-lingual retrieval and reranking achieve 100% recall on Vietnamese-to-English translations, surface character-level sentence alignment without a bilingual translation dictionary is unaligned (Span IoU 0.0). Spans are highlighted at passage/paragraph level.",
      "mitigation_in_rc1": "Passage-level bounding boxes and full English source paragraph displayed in Evidence Workbench for human side-by-side inspection."
    },
    {
      "id": "LIM-02",
      "area": "scanned_pdf_text_extraction",
      "description": "PDF files without a digital text layer (pure image scans) cannot be parsed by pdfminer.six in RC1.",
      "mitigation_in_rc1": "Documents lacking extractable text layer trigger EMPTY_TEXT or CORRUPTED_DOCUMENT error codes cleanly without worker crash; selective OCR is deferred to conditional extension EXT-02."
    },
    {
      "id": "LIM-03",
      "area": "figures_and_source_code",
      "description": "Non-text reuse modalities (diagrams, architectural figures, formulas, programming source code) are outside the 6-week academic text reuse charter.",
      "mitigation_in_rc1": "Explicit scope boundary stated in thesis charter; negative regex filters prevent code array indices from polluting citation detectors."
    },
    {
      "id": "LIM-04",
      "area": "extreme_paraphrase_uncertainty",
      "description": "Heavily rewritten passages with zero lexical overlap and abstract conceptual rephrasing may yield reranker scores near 0.40-0.65.",
      "mitigation_in_rc1": "Calibrated three-band review policy routes ambiguous cases into uncertainty review queue rather than making unreliable binary assertions."
    }
  ]
