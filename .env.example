# --- Core Service Connectivity (Native Dev: Render / Neon / Redis Cloud) ---
POSTGRES_DSN=postgresql://user:replace-with-password@ep-example-pooler.ap-southeast-1.aws.neon.tech/ugtm_ai_dev?sslmode=require
POSTGRES_DIRECT_DSN=postgresql://user:replace-with-password@ep-example.ap-southeast-1.aws.neon.tech/ugtm_ai_dev?sslmode=require
REDIS_URL=rediss://default:replace-with-password@redis-example.ap-southeast-1-1.ec2.redns.redis-cloud.com:12345
API_KEY=replace-with-long-random-private-key

# Optional variable used only by local Docker Compose fallback (compose.yaml)
POSTGRES_PASSWORD=replace-with-strong-password
AI_API_KEY=replace-with-long-random-private-key

# --- Upload & Local Runtime Paths ---
MAX_UPLOAD_MB=20
DATA_DIR=data/runtime

# --- Inference Mode & Remote GPU Worker (Colab) ---
# Must be explicit: "remote" (default for API & CPU worker; never falls back to local CPU)
# or "local" (requires requirements/gpu-colab.txt with torch>=2.6.0 + safetensors).
INFERENCE_MODE=remote
REMOTE_GPU_URL=
REMOTE_GPU_API_KEY=
REMOTE_GPU_TIMEOUT_SECONDS=180
REMOTE_GPU_HEALTH_TIMEOUT_SECONDS=5
REMOTE_GPU_BATCH_SIZE=32

# --- Model & Artifact Configuration ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_REVISION=
EMBEDDING_DIM=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_REVISION=
CLASSIFIER_ENABLED=false
CLASSIFIER_PATH=artifacts/suspicious_passage_classifier.joblib
